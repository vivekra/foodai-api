generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== AUTH (better-auth compatible) =====

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  role          UserRole  @default(CUSTOMER)
  phone         String?
  whatsappPhone String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  restaurantUsers RestaurantUser[]
  orders          Order[]
  reviews         Review[]
  notifications   Notification[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
  RESTAURANT_STAFF
  CUSTOMER
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id            String    @id @default(cuid())
  userId        String
  accountId     String
  providerId    String
  accessToken   String?
  refreshToken  String?
  idToken       String?
  expiresAt     DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ===== RESTAURANT =====

model Restaurant {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  description   String?
  logoUrl       String?
  coverImageUrl String?
  cuisineType   String[]
  phone         String?
  whatsappNumber String?
  email         String?
  addressLine1  String
  addressLine2  String?
  city          String
  postcode      String
  country       String           @default("GB")
  latitude      Float?
  longitude     Float?

  subscriptionPlan    SubscriptionPlan @default(FREE)
  subscriptionEndsAt  DateTime?
  stripeAccountId     String?
  stripeOnboarded     Boolean          @default(false)
  isActive            Boolean          @default(true)
  isVerified          Boolean          @default(false)

  openingHours        Json             @default("{}")
  minimumOrderAmount  Decimal          @default(0) @db.Decimal(10, 2)
  deliveryRadius      Float?
  avgPrepTimeMinutes  Int              @default(20)

  aiVoiceAgentEnabled Boolean  @default(false)
  aiVoiceAgentPhone   String?
  aiVoiceAgentPersona String?

  qrMenuEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           RestaurantUser[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  orders          Order[]
  reviews         Review[]
  deliveryConfigs RestaurantDeliveryConfig[]
  notifications   Notification[]
  aiCallLogs      AICallLog[]
  pricingOverride RestaurantPricingOverride?
  tables          RestaurantTable[]

  @@index([slug])
  @@index([city, isActive])
  @@index([postcode])
  @@map("restaurants")
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model RestaurantUser {
  id           String    @id @default(cuid())
  restaurantId String
  userId       String
  role         StaffRole @default(STAFF)
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@map("restaurant_users")
}

enum StaffRole {
  OWNER
  MANAGER
  STAFF
  KITCHEN
}

model RestaurantTable {
  id           String     @id @default(cuid())
  restaurantId String
  tableNumber  String
  qrCode       String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, tableNumber])
  @@map("restaurant_tables")
}

// ===== MENU =====

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  imageUrl     String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, isActive])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  basePrice    Decimal  @db.Decimal(10, 2)
  imageUrl     String?

  sizes    Json @default("[]")
  addons   Json @default("[]")

  calories     Int?
  ingredients  String[]
  dietary      String[]
  spiceLevel   Int      @default(0)
  allergens    String[]

  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([restaurantId, isActive])
  @@index([categoryId])
  @@map("menu_items")
}

// ===== ORDERS =====

model Order {
  id           String      @id @default(cuid())
  restaurantId String
  userId       String?
  tableId      String?
  orderNumber  String      @unique
  status       OrderStatus @default(PENDING)
  orderType    OrderType   @default(COUNTER)

  subtotal       Decimal @db.Decimal(10, 2)
  deliveryFee    Decimal @default(0) @db.Decimal(10, 2)
  platformFee    Decimal @default(0) @db.Decimal(10, 2)
  voiceSurcharge Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  paymentMethod   String?
  paymentLinkUrl  String?

  deliveryProvider    String?
  deliveryTrackingUrl String?
  deliveryQuoteId     String?
  estimatedDeliveryAt DateTime?
  deliveryAddress     Json?

  placedByAI  Boolean @default(false)
  aiChannel   String?

  notifiedViaWhatsApp Boolean @default(false)
  notifiedViaSms      Boolean @default(false)

  estimatedPrepTime Int?
  acceptedAt        DateTime?
  readyAt           DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  specialInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  user       User?            @relation(fields: [userId], references: [id])
  table      RestaurantTable? @relation(fields: [tableId], references: [id])
  items      OrderItem[]
  deliveries Delivery[]
  aiCallLog  AICallLog?

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

enum OrderType {
  QR_TABLE
  COUNTER
  DELIVERY
  COLLECTION
  VOICE
  AI_CHAT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  menuItemId     String
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)
  selectedSize   Json?
  selectedAddons Json    @default("[]")
  notes          String?

  createdAt DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ===== AI VOICE =====

model AICallLog {
  id           String   @id @default(cuid())
  restaurantId String
  orderId      String?  @unique
  callSid      String   @unique
  callerPhone  String?
  durationSec  Int?
  transcript   String?  @db.Text
  intentData   Json?
  outcome      String?
  errorMessage String?
  livekitRoomId String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])

  @@index([restaurantId, createdAt])
  @@map("ai_call_logs")
}

// ===== DELIVERY =====

model Delivery {
  id               String         @id @default(cuid())
  orderId          String
  provider         String
  providerJobId    String?
  status           DeliveryStatus @default(PENDING)
  trackingUrl      String?
  driverName       String?
  driverPhone      String?
  driverLocation   Json?
  quotedPrice      Decimal?       @db.Decimal(10, 2)
  actualPrice      Decimal?       @db.Decimal(10, 2)
  estimatedPickupAt  DateTime?
  estimatedDropoffAt DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  failureReason    String?
  webhookPayload   Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("deliveries")
}

enum DeliveryStatus {
  PENDING
  SEARCHING
  DRIVER_ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

model RestaurantDeliveryConfig {
  id              String   @id @default(cuid())
  restaurantId    String
  provider        String
  isEnabled       Boolean  @default(false)
  mode            String   @default("platform")
  encryptedConfig String?  @db.Text
  uberChildOrgId  String?
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, provider])
  @@map("restaurant_delivery_configs")
}

// ===== PRICING (Super Admin only) =====

model PlatformPricingConfig {
  id                       String  @id @default(cuid())
  version                  Int     @default(1)
  isActive                 Boolean @default(true)
  freeCommissionRate       Decimal @default(15.00) @db.Decimal(5, 2)
  starterCommissionRate    Decimal @default(8.00)  @db.Decimal(5, 2)
  proCommissionRate        Decimal @default(5.00)  @db.Decimal(5, 2)
  enterpriseCommissionRate Decimal @default(2.00)  @db.Decimal(5, 2)
  voiceSurchargeRate       Decimal @default(2.00)  @db.Decimal(5, 2)
  starterMonthlyGbp        Decimal @default(29.00) @db.Decimal(10, 2)
  proMonthlyGbp            Decimal @default(79.00) @db.Decimal(10, 2)
  enterpriseMonthlyGbp     Decimal @default(199.00) @db.Decimal(10, 2)
  updatedBy                String
  changeReason             String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("platform_pricing_configs")
}

model RestaurantPricingOverride {
  id              String    @id @default(cuid())
  restaurantId    String    @unique
  commissionRate  Decimal   @db.Decimal(5, 2)
  reason          String?
  expiresAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_pricing_overrides")
}

// ===== REVIEWS =====

model Review {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  rating       Int
  comment      String?
  images       String[]
  isVerified   Boolean  @default(false)
  orderId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([restaurantId, userId, orderId])
  @@index([restaurantId])
  @@map("reviews")
}

// ===== NOTIFICATIONS =====

model Notification {
  id           String           @id @default(cuid())
  restaurantId String?
  userId       String?
  type         NotificationType
  title        String
  body         String
  data         Json?
  isRead       Boolean          @default(false)
  channel      String?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([restaurantId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  PAYMENT_LINK_SENT
  NEW_REVIEW
  LOW_STOCK
  SYSTEM
}

// ===== AUDIT LOG =====

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
