{
  "name": "foodai-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --out-dir dist",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "express": "^5.0.1",
    "@types/express": "^5.0.0",
    "better-auth": "^1.4.0",
    "@prisma/client": "^6.1.0",
    "prisma": "^6.1.0",
    "@upstash/redis": "^1.34.3",
    "ioredis": "^5.4.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "socket.io": "^4.8.1",
    "bullmq": "^5.37.0",
    "stripe": "^17.5.0",
    "twilio": "^5.4.3",
    "openai": "^4.77.0",
    "@deepgram/sdk": "^3.9.0",
    "livekit-server-sdk": "^2.9.1",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "@types/cors": "^2.8.17",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.0.3",
    "zod": "^3.24.1",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "dotenv": "^16.4.7",
    "uuid": "^11.0.4",
    "@types/uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "@types/node": "^22.10.1"
  }
}
